def firstname
pipeline {
    agent any

    stages {
        stage('input') {
            steps {
                script{
                firstname=input (message: 'click submit to proceed', ok: 'Submit', parameters: [string(defaultValue: 'Sumant', description: 'FIRST NAME', name: 'FIRSTNAME', trim: true)])
                }
            }
        }
        stage('execute'){
            agent any
            steps{
                script{
                    echo "Hello ,$firstname" 
                }
               sh '''
                hostname
                uname -a
                ''' 
            }
        }
    }
}
