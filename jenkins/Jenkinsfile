pipeline{
  agent any
  stages{
    stage('build'){
      agent {
          label 'Node1'
       }
      steps{
        sh '''
            echo "Lisiting WORKSPACE contents:"
            ls -l ${WORKSPACE}
            echo "Build stage is completed"
        '''
      }
    }

    stage('deploy'){
      agent {
        label 'Node2'
      }
      steps{
        sh '''
            echo "Executing the script.sh ..............."
            bash ${WORKSPACE}/linux/script.sh
            echo "Deployment is successful"
        '''
      }
    }
  }
}
